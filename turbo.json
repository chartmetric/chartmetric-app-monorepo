{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:response-schemas": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/modules/**/schemas.generated.ts",
        "!openapi.generated.json"
      ],
      "outputs": ["src/modules/**/schemas.generated.ts"]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
