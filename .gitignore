# dependencies
node_modules

# build output
dist
dist-ssr
*.tsbuildinfo
*.d.ts.map

# caches
.turbo
.cache
.eslintcache
coverage

# logs
*.log

# environment
.env
.env.*
!.env.example
*.local

# OS
.DS_Store

# Lingui compiled catalogs (the Vite plugin compiles .po on demand; only CI runs `lingui compile`)
apps/web/src/locales/*/*/messages.js

# Agent config: .agents/ is committed (tool-agnostic); local state and
# per-tool symlinks (`ln -s .agents .claude`, `ln -s AGENTS.md CLAUDE.md`) are not
.agents/settings.local.json
.claude
/CLAUDE.md

# Harness runtime state: audit log, agent transcripts, per-phase locks
.harness/

# Python bytecode from the harness scripts
__pycache__/
*.py[cod]
