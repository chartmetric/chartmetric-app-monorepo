VITE_PROPELAUTH_AUTH_URL=''

# Base URL of the api app (its dev server port). Required: src/env.ts throws
# when it is missing, and auth requests go straight to this origin.
VITE_API_URL='http://localhost:8080'

# Vite proxies /app data requests here during local development, so they stay
# same-origin and skip CORS.
API_PROXY_TARGET=http://127.0.0.1:8008
