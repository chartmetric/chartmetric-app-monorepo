{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true
  },
  "exclude": [
    "dist",
    "vitest.smoke.config.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.smoke.ts",
    "**/tests/**"
  ]
}
