{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true
  },
  "exclude": [
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/tests/**",
    // Imported only by scripts/check-ch-schema-drift.mjs; keep it out of dist.
    "src/db/clickhouse/schema-drift.ts"
  ]
}
