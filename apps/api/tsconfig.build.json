{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true
  },
  "exclude": [
    "**/*.smoke.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
