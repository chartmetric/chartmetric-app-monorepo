# ClickHouse (read-only) — same names as the org-wide secrets file
CLICKHOUSE_HOST=''
CLICKHOUSE_USER=''
CLICKHOUSE_PASSWORD=''
AUTHSERVICE_URL=''
PORT=8080

# Server (optional — defaults shown)

# HOST=0.0.0.0
# LOG_LEVEL=info

# Comma-separated origin allowlist for /app/* CORS; unset reflects any origin
# CORS_ORIGIN=https://app.chartmetric.com,http://localhost:5173
