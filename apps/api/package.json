{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "pnpm generate:response-schemas",
    "generate:ch-schema": "node --env-file-if-exists=.env scripts/generate-ch-schema.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "generate:response-schemas": "node scripts/generate-response-schemas.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@hypequery/clickhouse": "^2.5.2",
    "@scalar/fastify-api-reference": "^1.63.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typia/utils": "^13.2.0",
    "eslint": "^10.7.0",
    "ttsc": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typia": "^13.2.0",
    "vitest": "^4.1.10"
  }
}
